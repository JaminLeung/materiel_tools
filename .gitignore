# Datakit 自动化部署系统

# 日志文件
*.log
logs/
log/

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~

# 备份文件
backup/
*.backup
*.bak

# 锁文件
*.lock
/var/run/

# 配置文件（包含敏感信息）
datakit-automation/config/env/*.sh
datakit-automation/config/scripts/*.sh
!datakit-automation/config/env/example.sh
!datakit-automation/config/env/ox.sh
!datakit-automation/config/scripts/*.sh
datakit-automation/logs
datakit-automation/runtime

# 加密配置文件
*.encrypted
*.enc

# 加密密钥文件
*.key
*.pem
*.p12
.datakit_encryption_key
encryption_key*

# 环境变量文件
.env
.env.local
.env.production
.env.development

# 系统文件
.DS_Store
Thumbs.db

# IDE 文件
.vscode/
.idea/
*.sublime-*

# 测试文件
test_*.sh
*_test.sh

# 临时目录
tmp/
temp/ 